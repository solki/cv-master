# CV Master Environment Configuration
# Copy this file to .env and fill in your values.

# Application
APP_ENV=development
LOG_LEVEL=INFO

# LLM Provider: openai_compatible | openai | anthropic | ollama
LLM_PROVIDER=openai_compatible

# OpenAI-compatible (e.g. DeepSeek)
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=https://api.deepseek.com
OPENAI_COMPATIBLE_MODEL=deepseek-v4-pro
OPENAI_COMPATIBLE_PROVIDER_NAME=deepseek

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=

# Tavily Search
TAVILY_API_KEY=

# Database
DATABASE_URL=postgresql+asyncpg://cv_master:cv_master@postgres:5432/cv_master
DATABASE_URL_SYNC=postgresql+psycopg2://cv_master:cv_master@postgres:5432/cv_master
POSTGRES_USER=cv_master
POSTGRES_PASSWORD=cv_master
POSTGRES_DB=cv_master

# Redis / Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Storage paths
VAULT_PATH=/app/vault
GENERATED_FILES_PATH=/app/generated
